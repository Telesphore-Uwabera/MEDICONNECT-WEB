# MediConnect web — local development
# Copy to a gitignored file before editing:  cp .env.example .env
#
# Every VITE_ value is compiled into the browser bundle.
# Do not put passwords in this file. VPN, SSH, MySQL, phpMyAdmin,
# SMTP, and Nginx passwords stay in a password manager or on the server.

# ── API (staging for local development) ──────────────────────────
VITE_APP_BASE_URL=https://staging-api.mediconnect.rw/api/v1

# Vite dev proxy target (vite.config.ts).
# Off VPN: public staging API. On VPN, uncomment the internal server lines.
VITE_DEV_API_TARGET=https://staging-api.mediconnect.rw
VITE_DEV_API_HOST=staging-api.mediconnect.rw
# VITE_DEV_API_TARGET=http://10.10.141.149
# VITE_DEV_API_HOST=staging-api.mediconnect.rw

# Production API — use only for a production-pointing build:
# VITE_APP_BASE_URL=https://api.mediconnect.rw/api/v1

# ── Laravel Reverb (public client key) ───────────────────────────
VITE_REVERB_APP_KEY=mediconnect-staging-key
VITE_REVERB_HOST=ws.mediconnect.rw
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=wss

# ── WebRTC TURN (secret stays empty here; set it only in .env) ──
VITE_TURN_HOST=
VITE_TURN_PORT=3478
VITE_TURN_SECRET=

# ── Optional overrides read by a few screens ─────────────────────
# VITE_STORAGE_URL=
# VITE_APP_STORAGE_URL=
# VITE_API_BASE_URL=
# VITE_SIGNAL_PATH=/public/consultations/signal

VITE_DEV=true

# ── Handover reference (not read by this app) ────────────────────
# VPN:            vpn.aos.rw | user.mediconnect | group MEDICONNECT-LTD
# Server:         Mediconnect-svr | 10.10.141.149 | ssh root@10.10.141.149 | alias: ssh mediconnect
# MySQL:          127.0.0.1:3306 | database mediconnect | user root
# phpMyAdmin:     https://db.mediconnect.rw | user medi.connect
# SMTP user:      mediconnectrwanda@gmail.com  (Laravel backend only)
# Nginx auth user: mediconnect
# Frontend:       https://staging.mediconnect.rw | https://mediconnect.rw
# API:            https://staging-api.mediconnect.rw | https://api.mediconnect.rw
# Database UI:    https://db.mediconnect.rw
# WebSocket:      wss://ws.mediconnect.rw
