# ─────────────────────────────────────────────────────────────────
# MediConnect – local development environment
# DO NOT commit this file. See .env.example for the template.
# Server / DB / SMTP / SSH credentials live here for reference only;
# they are never exposed to the browser (no VITE_ prefix).
# ─────────────────────────────────────────────────────────────────

# ── API (Vite bakes this into the JS bundle) ──────────────────────
# Relative path — Netlify rewrites /api/v1/* → https://api.mediconnect.rw/api/v1/:splat
# Storage files: /storage/* → https://api.mediconnect.rw/storage/:splat
# No hardcoded IPs or external API references anywhere in the frontend.
VITE_APP_BASE_URL=/api/v1

# ── Realtime – Laravel Reverb (WebSockets) ────────────────────────
VITE_REVERB_APP_KEY=mediconnect-staging-key
VITE_REVERB_HOST=ws.mediconnect.rw
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=wss

# ── WebRTC TURN server ────────────────────────────────────────────
VITE_TURN_HOST=197.243.29.114
VITE_TURN_PORT=3478
VITE_TURN_SECRET=mediconnect-turn-secret

# ── Dev flag (set to false for production-like local builds) ──────
VITE_DEV=true

