PORT=4000
WS_PORT=8080
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mediconnect
DB_USERNAME=root
DB_PASSWORD=
UPLOAD_DIR=./storage
PUBLIC_URL=http://10.10.141.149

# ── WebRTC ────────────────────────────────────────────────────────
# Signs consultation room tokens so the signal relay can reject a forged room
# name. Without it the relay only checks the room name inside the token.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CALL_TOKEN_SECRET=

# TURN relay. Required for a doctor and patient on different networks (mobile
# data, CGNAT) to connect — STUN alone cannot cross symmetric NAT. The host is
# also accepted as VITE_TURN_HOST from the repo-root .env.
TURN_HOST=
TURN_PORT=3478
TURNS_PORT=5349

# Set ONE of these, matching how the relay was configured. Prefer the secret:
# the browser then only receives a short-lived derived credential.
#   TURN_SECRET  — when coTURN runs with use-auth-secret (match static-auth-secret)
#   TURN_USERNAME + TURN_PASSWORD — when coTURN lists a static user= entry
TURN_SECRET=
TURN_USERNAME=
TURN_PASSWORD=

# GitHub Actions posts this to POST /api/v1/deploy to pull and restart the API.
# Without it the webhook answers 503 and pushes to main do not reach this server.
# Copy the value from the repository's DEPLOY_SECRET secret setting.
DEPLOY_SECRET=
